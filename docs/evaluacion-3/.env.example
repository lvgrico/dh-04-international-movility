# Runtime connection: least-privilege role (cannot UPDATE/DELETE audit_event)
DATABASE_URL=postgres://imams_app:imams_app@localhost:5432/imams
# Used only by db:migrate / db:reset and by the test helpers
DATABASE_ADMIN_URL=postgres://postgres:imams@localhost:5432/imams
PORT=3000
# Enables /sim/* endpoints (SIS outage, notifier failure, run worker once). Never in production.
ENABLE_SIMULATORS=true
OFFER_WINDOW_DAYS=14
